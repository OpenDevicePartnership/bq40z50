            field OCD1 4,
            field OCD2 5,
            field AOLD 6,
            field AOLDL 7,
            field ASCC 8,
            field ASCCL 9,
            field ASCD 10,
            field ASCDL 11,
            field OTC 12,
            field OTD 13,
            field CUVC 14,
            field OTF 16,
            field PTO 18,
            field PTOS 19,
            field CTO 20,
            field OC 22,
            field CHGC 23,
            field CHGV 24,
            field PCHGC 25,
            field UTC 26,
            field UTD 27,
        },
    },
    command MAC_PF_ALERT {
        address: 0x445200,
        fields-out: fieldset _ {
            size-bytes: 4,
        
            field SUV 0,
            field SOV 1,
            field SOCC 2,
            field SOCD 3,
            field SOT 4,
            field SOTF 6,
            field QIM 7,
            field CB 8,
            field IMP 9,
