                Reserved: 0,
                FullAccess: 1,
                UnSealed: 2,
                Sealed: 3,
            },
            field SDV 10,
            field SS 11,
            field PF 12,
            field XDSG 13,
            field XCHG 14,
            field SLEEP 15,
            field SDM 16,
            field LED 17,
            field AUTH 18,
            field AUTOCALM 19,
            field CAL 20,
            field CAL_OFFSET 21,
