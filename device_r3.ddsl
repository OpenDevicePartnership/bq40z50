    command MAC_OPERATION_STATUS {
        address: 0x445400,
        fields-out: fieldset _ {
            size-bytes: 4,
        
            field PRES 0,
            field DSG 1,
            field CHG 2,
            field PCHG 3,
            field FUSE 5,
            field BTP_INT 7,
