    },
    command MAC_LIFETIME_DATA_SPEED_UP_MODE {
        address: 0x442f00,
    },
    command MAC_SEAL {
        address: 0x443000,
    },
    command MAC_DEVICE_RESET {
        address: 0x444100,
    },
    command MAC_SAFETY_ALERT {
        address: 0x445000,
        fields-out: fieldset _ {
            size-bytes: 4,
        
            field CUV 0,
            field COV 1,
            field OCC1 2,
            field OCC2 3,
            field OCD1 4,
            field OCD2 5,
            field AOLDL 7,
            field ASCCL 9,
            field ASCDL 11,
            field OTC 12,
            field OTD 13,
