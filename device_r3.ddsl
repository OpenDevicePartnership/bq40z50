            field AFEC 21,
            field SECOND_LVL 22,
            field OPNC 25,
            field TS1 28,
            field TS2 29,
            field TS3 30,
            field TS4 31,
        },
    },
    command MAC_PF_STATUS {
        address: 0x445300,
        fields-out: fieldset _ {
            size-bytes: 4,
        
            field SUV 0,
            field SOV 1,
            field SOCC 2,
            field SOCD 3,
            field SOT 4,
            field SOTF 6,
            field QIM 7,
            field CB 8,
            field IMP 9,
            field CD 10,
            field VIMR 11,
            field VIMA 12,
            field CFETF 16,
            field DFETF 17,
            field FUSE 19,
            field AFER 20,
            field AFEC 21,
            field SECOND_LVL 22,
            field PTC 23,
            field IFC 24,
            field OPNCELL 25,
            field DFW 26,
            field TS1 28,
            field TS2 29,
