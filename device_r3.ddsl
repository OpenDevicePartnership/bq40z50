            field SLEEPM 23,
            field INIT 24,
            field SMBLCAL 25,
            field SLPAD 26,
            field SLPCC 27,
            field CB 28,
            field EMSHUT 29,
        },
    },
    command MAC_CHARGING_STATUS {
        address: 0x445500,
        fields-out: fieldset _ {
            size-bytes: 4,
        
            field UT 0,
            field LT 1,
            field STL 2,
