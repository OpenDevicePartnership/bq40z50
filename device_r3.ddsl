device Device {
    default-byte-order: LE,
    register-address-type: u8,
    command-address-type: u32,
    buffer-address-type: u8,
    default-access: RW,

    /// The device can be checked for the IC part number.
    command MAC_DEVICE_TYPE {
        address: 0x440100,
        fields-out: fieldset _ {
            size-bytes: 2,
        
            field DEVICE_TYPE 15:0,
        },
    },
    /// The device can be checked for the firmware version of the IC.
    command MAC_FIRMWARE_VERSION {
        address: 0x440200,
        fields-out: fieldset _ {
            size-bytes: 11,
        
            field DEVICE_NUMBER 15:0,
            field VERSION 31:16,
            field BUILD_NUMBER 47:32,
            field FIRMWARE_TYPE 55:48,
            field IMPEDENCE_TRACK_VERS 71:56,
        },
    },
    command MAC_HARDWARE_VERSION {
        address: 0x440300,
        fields-out: fieldset _ {
            size-bytes: 1,
        
            field HW_VERS 7:0,
        },
    },
    command MAC_INSTRUCTION_FLASH_SIGNATURE {
        address: 0x440400,
        fields-out: fieldset _ {
            size-bytes: 1,
        
            field INSN_FLSH_SIG 7:0,
        },
    },
    command MAC_STATIC_DF_SIGNATURE {
        address: 0x440500,
        fields-out: fieldset _ {
            size-bytes: 2,
        
            field STATIC_DF_SIG 14:0,
            field SIG_MISMATCH 15,
        },
    },
    command MAC_CHEM_ID {
        address: 0x440600,
        fields-out: fieldset _ {
            size-bytes: 1,
        
            field CHEM_ID 7:0,
        },
    },
    command MAC_STATIC_CHEM_DF_SIG {
        address: 0x440800,
        fields-out: fieldset _ {
            size-bytes: 2,
        
            field STATIC_CHEM_DF_SIG 14:0,
            field SIG_MISMATCH 15,
        },
    },
    command MAC_ALL_DF_SIGNATURE {
        address: 0x440900,
        fields-out: fieldset _ {
            size-bytes: 2,
        
            field STATIC_CHEM_DF_SIG 14:0,
            field SIG_MISMATCH 15,
        },
    },
    command MAC_SHUTDOWN_MODE {
        address: 0x441000,
    },
    command MAC_SLEEP_MODE {
        address: 0x441100,
    },
    command MAC_AUTO_CC_OFFSET {
        address: 0x441300,
    },
    command MAC_FUSE_TOGGLE {
        address: 0x441d00,
    },
    command MAC_PCHG_FET_TOGGLE {
        address: 0x441e00,
    },
    command MAC_CHG_FET_TOGGLE {
        address: 0x441f00,
    },
    command MAC_DSG_FET_TOGGLE {
        address: 0x442000,
    },
    /// This command enables or disables the gauging function to ease
    /// testing during manufacturing. 
    command MAC_GAUGING {
        address: 0x442100,
    },
    command MAC_FET_CTRL {
        address: 0x442200,
    },
    command MAC_LIFETIME_DATA_COLLECTION {
        address: 0x442300,
    },
    command MAC_PERMANENT_FAILURE {
        address: 0x442400,
    },
    command MAC_BLACK_BLOCK_RECORDER {
        address: 0x442500,
    },
    command MAC_FUSE {
        address: 0x442600,
    },
    command MAC_LED_DISP_EN {
        address: 0x442700,
    },
    command MAC_LIFETIME_DATA_RST {
        address: 0x442800,
    },
    command MAC_PF_DATA_RST {
        address: 0x442900,
    },
    command MAC_BLK_BOX_REC_RESET {
        address: 0x442a00,
    },
    command MAC_LED_TOGGLE {
        address: 0x442b00,
    },
    command MAC_LED_DISP_PRESS {
        address: 0x442c00,
    },
    command MAC_CALIBRATION_MODE {
        address: 0x442d00,
    },
